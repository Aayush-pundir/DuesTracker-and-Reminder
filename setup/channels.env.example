# Copy to data/channels.env  (that folder is git-ignored). One KEY=VALUE per line. Real environment variables override this file.
# Restart the app after editing.

# --- Microsoft 365 e-mail (Microsoft Graph) - values printed by setup/azure_app_registration.sh ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER=accounts@eroute.in

# --- or SMTP AUTH fallback (only if enabled for the mailbox) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=accounts@eroute.in
# SMTP_PASSWORD=

# --- WhatsApp Business Cloud API ---
# WA_PHONE_ID=
# WA_TOKEN=
# WA_LANG=en

# --- Zoho Books API ---
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_REFRESH_TOKEN=
# ZOHO_ORG_ID=60008687140
# ZOHO_DC=in
